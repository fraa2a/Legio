{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Legio Launcher",
  "identifier": "dev.fraa2a.legio",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Legio Launcher",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY3MDhBQjRFMDQ4RDkyRjQKUldUMGtvMEVUcXNJOXk2d1lMblVlT1pHTU5uaWI5b0N1SkRBbzE1OCs0NTlGR1JZT2U2L1Jya1IK",
      "endpoints": ["https://github.com/fraa2a/Legio/releases/latest/download/latest.json"]
    }
  }
}
